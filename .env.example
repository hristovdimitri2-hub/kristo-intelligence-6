# Kristo Intelligence v5 — конфигурация
# Копирай този файл като .env и попълни стойностите

# ── Base44 API ────────────────────────────────────────────────────────────
BASE44_API_KEY=your_base44_api_key_here
BASE44_API_BASE=https://api.base44.com

# ── CoinGecko API ──────────────────────────────────────────────────────────
# Опционален API key за Demo/Pro plan (без него се използва free tier с лимити)
# COINGECKO_API_KEY=your_api_key_here

# ── Base мрежа ────────────────────────────────────────────────────────────
# Private key на портфейла (БЕЗ 0x prefix или с него — и двете работят)
# ВНИМАНИЕ: Никога не commit-вай .env файла!
WALLET_PRIVATE_KEY=

# RPC URL (по подразбиране публичен Base mainnet)
BASE_RPC_URL=https://mainnet.base.org

# Chain ID (Base mainnet = 8453, Base Sepolia = 84532)
BASE_CHAIN_ID=8453

# USDC контракт на Base
BASE_USDC_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Такса за заявка в USDC
BASE_FEE_AMOUNT_USDC=0.10

# Адрес на получител на таксата (НЕ използвай zero address)
# Твърд fallback в config.py: 0xd4cdA900839C0FED4374EE37EA0DBE8e4c6fd08f
BASE_FEE_RECEIVER=0xd4cdA900839C0FED4374EE37EA0DBE8e4c6fd08f

# ── Trading Agent ─────────────────────────────────────────────────────────
# Автоматично изпълнение на действия (true/false)
# ВНИМАНИЕ: true означава реални транзакции!
AGENT_AUTO_EXECUTE=false

# Максимална позиция в USD
AGENT_MAX_POSITION_USD=1000

# Максимална обща експозиция в USD
AGENT_MAX_EXPOSURE_USD=5000

# Минимален APY за влизане в позиция
AGENT_MIN_APY=20

# Максимален риск score (0-100)
AGENT_MAX_RISK=60

# Интервал между цикли (секунди)
AGENT_POLL_INTERVAL=300

# Максимален gas price в Gwei (Base е много евтин)
AGENT_MAX_GAS_GWEI=0.5

# ── Логинг ────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO

# ── Telegram Sales Bot ──────────────────────────────────────────────────────
# Bot token от @BotFather (задължителен за telegram_sales.py).
# В Replit го добави през Secrets като TELEGRAM_BOT_TOKEN; не го записвай в Git.
TELEGRAM_BOT_TOKEN=
# Chat ID на канала/групата, към който се изпращат бюлетини
TELEGRAM_VIP_CHAT_ID=
# Алтернативен chat ID (опционален)
# TELEGRAM_CHAT_ID=
# Интервал между автоматичните бюлетини в секунди (по подразбиране 1800 = 30 мин)
# TELEGRAM_SALES_INTERVAL=1800

# ── Launch + Sales Ops ─────────────────────────────────────────────────────
# Public app URL for successful checkout redirects
# APP_PUBLIC_URL=https://your-domain.com
# Public URL used by Telegram webhook registration (normally the same address).
# WEBHOOK_PUBLIC_URL=https://your-domain.com
# Remote webhook registration mutates Telegram bot configuration. Enable it only
# in production after the final published URL is confirmed; keep it unset locally.
# TELEGRAM_WEBHOOK_AUTOREGISTER=true

# Stripe is configured through the Replit Stripe Integration and deployment
# settings. Never paste Stripe key values into this file or commit a .env file.

# Replit PostgreSQL supplies DATABASE_URL automatically at runtime.
# Do not set or commit DATABASE_URL manually.

# Optional app-level tracking for real campaign attribution
# APP_TRACKING_ENABLED=true
# APP_DEFAULT_CAMPAIGN=launch

# ── AI provider ────────────────────────────────────────────────────────────
# OpenRouter is used by default through the OpenAI-compatible API.
# OPENROUTER_API_KEY=your_openrouter_key
# GLM_API_BASE=https://openrouter.ai/api/v1
# GLM_MODEL=openai/gpt-4o-mini

# ── Admin API ───────────────────────────────────────────────────────────────
# Required for CRM/admin reads. Send as X-Admin-Token.
# ADMIN_API_TOKEN=use-a-long-random-secret

# ── NEXUS Discovery Engine ──────────────────────────────────────────────────
# Публичен URL на NEXUS платформата (Render). По подразбиране се използва
# https://nexus-discovery-engine.onrender.com
# NEXUS_URL=https://nexus-discovery-engine.onrender.com
