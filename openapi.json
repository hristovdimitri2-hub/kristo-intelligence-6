{
  "openapi": "3.0.3",
  "info": {
    "title": "Kristo Intelligence API",
    "version": "6.1.0",
    "description": "Repository reference only. The authoritative specification is generated at runtime at /openapi.json and always reflects the active human-approved catalog."
  },
  "servers": [
    {
      "url": "/",
      "description": "Use the published application origin."
    }
  ],
  "paths": {
    "/api/v1/agents": {
      "get": {
        "summary": "List active human-approved agent utilities",
        "responses": {
          "200": {
            "description": "Active catalog"
          },
          "503": {
            "description": "Catalog approval or migration required"
          }
        }
      }
    },
    "/api/v1/agents/{agent_id}/playground": {
      "post": {
        "summary": "Run a bounded utility with free, x402 or entitlement access",
        "responses": {
          "200": {
            "description": "Utility result"
          },
          "402": {
            "description": "Request-bound x402 challenge"
          }
        }
      }
    },
    "/api/mcp/manifest": {
      "get": {
        "summary": "Runtime MCP and payment manifest",
        "responses": {
          "200": {
            "description": "Machine-readable discovery"
          }
        }
      }
    },
    "/mcp.json": {
      "get": {
        "summary": "Runtime MCP catalog discovery",
        "responses": {
          "200": {
            "description": "MCP JSON"
          }
        }
      }
    },
    "/.well-known/x402.json": {
      "get": {
        "summary": "Runtime x402 discovery",
        "responses": {
          "200": {
            "description": "x402 payment metadata"
          }
        }
      }
    },
    "/api/launch/health": {
      "get": {
        "summary": "Public commercial launch readiness",
        "responses": {
          "200": {
            "description": "All launch gates verified"
          },
          "503": {
            "description": "One or more launch gates remain blocked"
          }
        }
      }
    }
  },
  "x-runtime-source": "/openapi.json"
}