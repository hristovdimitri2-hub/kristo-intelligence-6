modules = ["python-3.12", "nodejs-20", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["postgresql"]

[agent]
expertMode = true

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 10000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 python main.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[deployment]
deploymentTarget = "vm"
run = ["bash", "-c", "exec gunicorn --bind=0.0.0.0:${PORT:-10000} --workers=1 main:app"]

[userenv]

[userenv.shared]
APP_PUBLIC_URL = "https://kristo-intelligence-v-5.replit.app"
WEBHOOK_PUBLIC_URL = "https://kristo-intelligence-v-5.replit.app"
